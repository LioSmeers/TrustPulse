# Public app origin used when real invitations are sent
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Supabase project connection; leave empty to use the local demo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Alternatively use the new Supabase secret key (sb_secret_...).
SUPABASE_SECRET_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional: use a Messaging Service instead of TWILIO_FROM_NUMBER.
TWILIO_MESSAGING_SERVICE_SID=

# Server only: Places API (New), never use NEXT_PUBLIC_ for this key.
GOOGLE_PLACES_API_KEY=
